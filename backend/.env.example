PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careerlens?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
# Production frontend domain (CORS control)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vercel project slug for trusted preview deployments (e.g. careerlens-frontend-*.vercel.app)
FRONTEND_PROJECT_NAME=careerlens-frontend
AI_SERVICE_URL=http://127.0.0.1:8000
STORAGE_TYPE=local
RESUME_STORAGE_PATH=./uploads/resumes

