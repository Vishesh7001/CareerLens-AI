# Local server port (used when running uvicorn directly)
AI_SERVICE_PORT=8000
NODE_ENV=development
AI_PROVIDER=fastapi-nlp-engine

# Allowed frontend and backend origins for CORS
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Frontend project slug for trusted preview deployments (e.g. careerlens-frontend-*.vercel.app)
FRONTEND_PROJECT_NAME=careerlens-frontend


