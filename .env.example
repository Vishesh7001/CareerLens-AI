# ==============================================================
# CareerLens AI - Root Environment Variables Example
# Duplicate this file as .env or set individual services .env
# ==============================================================

# Backend (Express / Node.js)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careerlens?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
RESUME_STORAGE_PATH=./uploads/resumes
NODE_ENV=development

# Frontend (Vite / React)
VITE_API_URL=http://localhost:5000/api

# AI Microservice (FastAPI / Python)
AI_SERVICE_PORT=8000

